# Copiar a .env y completar. El archivo .env no se sube al repo.
SUPERADMIN_EMAIL=vos@tudominio.com
SUPERADMIN_PASSWORD=cambiar-por-una-clave-larga

# Opcionales (valores por defecto entre parentesis)
# PUBLIC_URL=https://diablomastermix.com.ar
# BAND_QUOTA_GB=15
# RAW_RETENTION_DAYS=30
# MAX_UPLOAD_MB=3000
# REFERENCE_SECONDS=90
# CORS_ORIGINS=http://localhost:5173
# Asistente con IA (opcional; cuesta centavos por consulta en OpenAI). Sin clave queda apagado.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ASSISTANT_DAILY_LIMIT=20

# Tapas de album con IA (opcional, tiene costo por imagen). Usa la misma OPENAI_API_KEY.
# COVER_AI_MODEL=gpt-image-1
# COVER_AI_DAILY_LIMIT=5
