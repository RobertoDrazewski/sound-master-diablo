# Copiar a .env y completar. El archivo .env no se sube al repo.
SUPERADMIN_EMAIL=vos@tudominio.com
SUPERADMIN_PASSWORD=cambiar-por-una-clave-larga

# Opcionales (valores por defecto entre parentesis)
# PUBLIC_URL=https://diablomastermix.com.ar
# BAND_QUOTA_GB=15
# RAW_RETENTION_DAYS=30
# MAX_UPLOAD_MB=3000
# REFERENCE_SECONDS=90
# CORS_ORIGINS=http://localhost:5173
# Asistente con IA (opcional; cuesta centavos por consulta en OpenAI). Sin clave queda apagado.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ASSISTANT_DAILY_LIMIT=20

# Tapas de album con IA (opcional, tiene costo por imagen). Usa la misma OPENAI_API_KEY.
# COVER_AI_MODEL=gpt-image-1
# COVER_AI_DAILY_LIMIT=5

# ---- Suscripciones (Mercado Pago) ----
# MP_ACCESS_TOKEN=APP_USR-...        # credencial de PRODUCCION de tu aplicacion de Mercado Pago
# MP_WEBHOOK_SECRET=                 # "clave secreta" de la notificacion (Tus integraciones > Webhooks)
# TRIAL_DAYS=14                      # prueba gratis de las bandas nuevas que pagan
# PAST_DUE_GRACE_DAYS=3              # dias de gracia antes de cortar por falta de pago

# ---- Formulario de contacto ----
# TURNSTILE_SITE_KEY=                # Cloudflare Turnstile (clave del sitio)
# TURNSTILE_SECRET=                  # Cloudflare Turnstile (clave secreta)
# SMTP_USER=                         # cuenta de Gmail que envia
# SMTP_PASSWORD=                     # contrasena de aplicacion de Google (16 letras, sin espacios)
# CONTACT_TO=                        # donde llegan los mensajes (por defecto SUPERADMIN_EMAIL)
# RESEND_API_KEY=                    # alternativa a SMTP

# ---- Chat con el ingeniero de audio (usa OPENAI_API_KEY) ----
# CHAT_ENABLED=1
# CHAT_DAILY_LIMIT=400               # mensajes por dia en total (tope de gasto)
# CHAT_IP_HOURLY=20                  # mensajes por hora por visitante

# A donde responden los clientes a los mails automaticos (confirmacion de pago, clave de acceso). Opcional.
# Usa una direccion de la marca (no tu correo personal): nunca se muestra en la web.
SUPPORT_EMAIL=

# Horas entre la baja de una banda y el borrado de todos sus datos (por defecto 48)
# PURGE_HOURS=48
